# Public Supabase settings. Safe to expose in the browser.
# Copy these from the project's Connect dialog or Settings → API Keys.
# Use the publishable key (sb_publishable_...). Never put a secret key (sb_secret_...) here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# The project URL and API keys are injected into Edge Functions automatically.
# Do not add them under Edge Function secrets. See .env.secrets.example for the
# secrets you do set yourself (encryption key, research salt).
