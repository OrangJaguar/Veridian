# These are Supabase Edge Function secrets, not Vite variables.
# Set them after `supabase link`:
#   supabase secrets set --env-file .env.secrets
#
# Do NOT add SUPABASE_URL, the publishable key, or the secret key.
# Supabase injects those. Names starting with SUPABASE_ are rejected.
#
# NEVER prefix with VITE_. NEVER commit .env.secrets.

# Encrypts each user's NVIDIA key at rest. Use a long random string (32+ characters).
# Changing this later makes saved keys unreadable — users must paste their key again.
KEY_ENCRYPTION_SECRET=replace-with-a-long-random-string

# Optional model overrides. The key itself comes from each user's Settings page.
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
AI_HEAVY_MODEL=deepseek-ai/deepseek-v4-pro
AI_LIGHT_MODEL=deepseek-ai/deepseek-v4-flash

# Required before admin research export. Any long random string.
RESEARCH_SALT=replace-with-a-long-random-string

# Optional. Study reminders and error alerts use Resend when this is set.
RESEND_API_KEY=
EMAIL_FROM=Veridian <noreply@veridian.study>
ADMIN_ALERT_EMAIL=

# Optional. Protects the study-reminder function. Send it as the x-cron-secret header.
CRON_SECRET=

ENVIRONMENT=production
